{
  "name": "protocolia-vnext-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/compiler",
    "packages/adapters/jhipster"
  ],
  "scripts": {
    "build:vnext": "tsc -p packages/contracts/tsconfig.json && tsc -p packages/adapters/jhipster/tsconfig.json && tsc -p packages/compiler/tsconfig.json",
    "compile:taller": "npm run build:vnext && tsp compile examples/vnext/taller && node tests/vnext/verify-ir.mjs",
    "check:vnext": "npm run build:vnext && node --test tests/vnext/*.test.mjs && npm run compile:gauge",
    "probe:jhipster": "node scripts/vnext/probe-jhipster.mjs",
    "compile:gauge": "npm run build:vnext && tsp compile examples/vnext/gauge && node tests/vnext/verify-gauge-ir.mjs",
    "app:build": "node packages/cli/protocolia.mjs build",
    "app:test": "node packages/cli/protocolia.mjs test",
    "app:run": "node packages/cli/protocolia.mjs run",
    "app:plan": "node packages/cli/protocolia.mjs plan",
    "app:evolve": "node packages/cli/protocolia.mjs evolve",
    "app:evolve:verified": "node packages/cli/protocolia.mjs evolve:verified",
    "app:db:checkpoint": "node packages/cli/protocolia.mjs db:checkpoint",
    "app:db:verify": "node packages/cli/protocolia.mjs db:verify",
    "app:db:preflight": "node packages/cli/protocolia.mjs db:preflight",
    "app:db:stage": "node packages/cli/protocolia.mjs db:stage",
    "app:db:stage:verify": "node packages/cli/protocolia.mjs db:stage:verify",
    "app:db:source:verify": "node packages/cli/protocolia.mjs db:source:verify",
    "app:deploy:candidate": "node packages/cli/protocolia.mjs deploy:candidate",
    "app:deploy:candidate:verify": "node packages/cli/protocolia.mjs deploy:candidate:verify",
    "app:deploy:precheck": "node packages/cli/protocolia.mjs deploy:precheck",
    "app:deploy:postcheck": "node packages/cli/protocolia.mjs deploy:postcheck",
    "app:deploy:recovery:drill": "node packages/cli/protocolia.mjs deploy:recovery:drill",
    "app:deploy:recovery:verify": "node packages/cli/protocolia.mjs deploy:recovery:verify",
    "app:deploy:permit:verify": "node packages/cli/protocolia.mjs deploy:permit:verify",
    "app:deploy:fence:verify": "node packages/cli/protocolia.mjs deploy:fence:verify",
    "app:deploy:db-gate:engage": "node packages/cli/protocolia.mjs deploy:db-gate:engage",
    "app:deploy:db-gate:release": "node packages/cli/protocolia.mjs deploy:db-gate:release",
    "app:deploy:roles:prepare": "node packages/cli/protocolia.mjs deploy:roles:prepare",
    "app:deploy:roles:blocked": "node packages/cli/protocolia.mjs deploy:roles:blocked",
    "app:deploy:roles:activate": "node packages/cli/protocolia.mjs deploy:roles:activate"
  },
  "devDependencies": {
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "@typespec/json-schema": "1.17.0",
    "typescript": "5.9.3"
  }
}
