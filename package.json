{
  "name": "protocolia-vnext-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/compiler",
    "packages/adapters/jhipster"
  ],
  "scripts": {
    "build:vnext": "tsc -p packages/adapters/jhipster/tsconfig.json && tsc -p packages/compiler/tsconfig.json",
    "compile:taller": "npm run build:vnext && tsp compile examples/vnext/taller",
    "check:vnext": "npm run build:vnext && node --test tests/vnext/*.test.mjs"
  },
  "devDependencies": {
    "@typespec/compiler": "1.17.0",
    "@typespec/http": "1.17.0",
    "@typespec/openapi3": "1.17.0",
    "@typespec/json-schema": "1.17.0",
    "typescript": "5.9.3"
  }
}
