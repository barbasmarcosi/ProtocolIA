# Real compiled Spring and Nest opt-in worker conformance.
FROM eclipse-temurin:21-jdk AS java21
FROM node:24-bookworm AS node24
FROM maven:3.9.11-eclipse-temurin-21 AS maven39
FROM postgres:16-bookworm
COPY --from=java21 /opt/java/openjdk /opt/java/openjdk
COPY --from=node24 /usr/local /usr/local
COPY --from=maven39 /usr/share/maven /usr/share/maven
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=/opt/java/openjdk/bin:/usr/local/bin:/usr/share/maven/bin:$PATH
ENV CI=true
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY . .
RUN bash -n scripts/vnext/probe-a143-worker-postgres.sh
RUN npm ci --ignore-scripts --no-audit --no-fund
RUN npm run check:vnext && bash tests/vnext/negative-check.sh
RUN npm install --no-save --package-lock=false --ignore-scripts --no-audit --no-fund playwright@1.64.0
RUN npx playwright install --with-deps chromium
RUN node packages/cli/protocolia.mjs build examples/vnext/facility-maintenance-a143 \
  --target modular-spring --out /work/dist/a143-spring-app
RUN node packages/cli/protocolia.mjs build examples/vnext/facility-maintenance-a143 \
  --target nestjs --out /work/dist/a143-nest-app
# Actual populated A14.2 -> A14.3 migration for both generated backends.
RUN node packages/cli/protocolia.mjs build examples/vnext/facility-maintenance-a142 \
  --target modular-spring --out /work/dist/a143-old-spring
RUN node packages/cli/protocolia.mjs build examples/vnext/facility-maintenance-a142 \
  --target nestjs --out /work/dist/a143-old-nest
RUN bash -n scripts/vnext/probe-a143-upgrade-postgres.sh
RUN bash scripts/vnext/probe-a143-upgrade-postgres.sh
RUN bash scripts/vnext/probe-a143-worker-postgres.sh
RUN echo A143_BOTH_TARGETS_COMPILED_AUTOMATIC_WORKER_CONFORMANCE_PASS
