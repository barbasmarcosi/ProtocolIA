{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/barbasmarcosi/ProtocolIA/blob/main/benchmarks/run-record.schema.json",
  "title": "ProtocolIA comparison run record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "arm",
    "compiler_commit",
    "outcome",
    "measurements",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "enum": [
        "direct_agent",
        "ordinary_generator",
        "protocolia"
      ]
    },
    "compiler_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "outcome": {
      "enum": [
        "verified_pass",
        "verified_fail",
        "unverified",
        "blocked"
      ]
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_ms",
        "input_tokens",
        "output_tokens",
        "cached_tokens",
        "provider_cost_usd",
        "tool_cost_usd",
        "human_interventions"
      ],
      "properties": {
        "wall_time_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "provider_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tool_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "human_interventions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    },
    "provider_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    }
  }
}
