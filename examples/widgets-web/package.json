    "@rjsf/validator-ajv8": "6.7.1",
    "@rjsf/utils": "6.7.1",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "orval": "8.41.0",
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/node": "22.18.6",
    "vite": "7.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "@playwright/test": "1.56.1"
  }
