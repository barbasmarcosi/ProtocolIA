{
  "version": "0.4",
  "namespace": "Inventory",
  "models": {
    "WidgetRequest": {
      "sku": {
        "type": "string",
        "required": true,
        "constraints": {
          "minLength": 1,
          "maxLength": 64
        }
      },
      "label": {
        "type": "string",
        "required": true,
        "constraints": {
          "minLength": 1,
          "maxLength": 255
        }
      },
      "units": {
        "type": "integer",
        "required": true,
        "constraints": {
          "minimum": 0
        }
      }
    },
    "Widget": {
      "sku": {
        "type": "string",
        "required": true,
        "constraints": {
          "minLength": 1,
          "maxLength": 64
        }
      },
      "label": {
        "type": "string",
        "required": true,
        "constraints": {
          "minLength": 1,
          "maxLength": 255
        }
      },
      "units": {
        "type": "integer",
        "required": true,
        "constraints": {
          "minimum": 0
        }
      }
    },
    "Health": {
      "status": {
        "type": "string",
        "required": true,
        "constraints": {
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "UnitAdjustment": {
      "quantity": {
        "type": "integer",
        "required": true,
        "constraints": {
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "WidgetPage": {
      "items": {
        "type": "Widget[]",
        "required": true
      },
      "limit": {
        "type": "integer",
        "required": true,
        "constraints": {
          "minimum": 1,
          "maximum": 50
        }
      },
      "offset": {
        "type": "integer",
        "required": true,
        "constraints": {
          "minimum": 0
        }
      },
      "total": {
        "type": "integer",
        "required": true,
        "constraints": {
          "minimum": 0
        }
      }
    }
  },
  "operations": {
    "createWidget": {
      "method": "POST",
      "path": "/api/widgets",
      "request": "WidgetRequest",
      "response": "Widget",
      "capability": "inventory.write",
      "effects": [
        "write"
      ],
      "depends_on": [],
      "params": {}
    },
    "getWidget": {
      "method": "GET",
      "path": "/api/widgets/{sku}",
      "response": "Widget",
      "capability": "inventory.read",
      "effects": [
        "read"
      ],
      "depends_on": [],
      "params": {
        "sku": "string"
      }
    },
    "health": {
      "method": "GET",
      "path": "/health",
      "response": "Health",
      "capability": "public",
      "effects": [
        "read"
      ],
      "depends_on": [],
      "params": {}
    },
    "adjustUnits": {
      "method": "PATCH",
      "path": "/api/widgets/{sku}/units",
      "params": {
        "sku": "string"
      },
      "request": "UnitAdjustment",
      "response": "Widget",
      "capability": "inventory.write",
      "effects": [
        "read",
        "write"
      ],
      "depends_on": []
    },
    "listWidgets": {
      "method": "GET",
      "path": "/api/widgets",
      "response": "WidgetPage",
      "capability": "inventory.read",
      "effects": [
        "read"
      ],
      "depends_on": [],
      "params": {},
      "query": {
        "limit": {
          "type": "integer",
          "required": false,
          "default": 25,
          "constraints": {
            "minimum": 1,
            "maximum": 50
          }
        },
        "offset": {
          "type": "integer",
          "required": false,
          "default": 0,
          "constraints": {
            "minimum": 0,
            "maximum": 1000000
          }
        }
      }
    }
  }
}
