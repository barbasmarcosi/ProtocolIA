{
  "version": "0.4",
  "namespace": "Catalog",
  "models": {
    "BookRequest": {
      "isbn": {
        "type": "string",
        "required": true,
        "constraints": {
          "minLength": 1,
          "maxLength": 64
        }
      },
      "title": {
        "type": "string",
        "required": true,
        "constraints": {
          "minLength": 1,
          "maxLength": 255
        }
      },
      "stock": {
        "type": "integer",
        "required": true,
        "constraints": {
          "minimum": 0
        }
      },
      "publishedAt": {
        "type": "datetime",
        "required": false,
        "nullable": true
      }
    },
    "Book": {
      "isbn": {
        "type": "string",
        "required": true,
        "constraints": {
          "minLength": 1,
          "maxLength": 64
        }
      },
      "title": {
        "type": "string",
        "required": true,
        "constraints": {
          "minLength": 1,
          "maxLength": 255
        }
      },
      "stock": {
        "type": "integer",
        "required": true,
        "constraints": {
          "minimum": 0
        }
      },
      "publishedAt": {
        "type": "datetime",
        "required": false,
        "nullable": true
      }
    },
    "Health": {
      "status": {
        "type": "string",
        "required": true,
        "constraints": {
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "StockAdjustment": {
      "quantity": {
        "type": "integer",
        "required": true,
        "constraints": {
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "BookPage": {
      "items": {
        "type": "Book[]",
        "required": true
      },
      "limit": {
        "type": "integer",
        "required": true,
        "constraints": {
          "minimum": 1,
          "maximum": 50
        }
      },
      "offset": {
        "type": "integer",
        "required": true,
        "constraints": {
          "minimum": 0
        }
      },
      "total": {
        "type": "integer",
        "required": true,
        "constraints": {
          "minimum": 0
        }
      }
    },
    "TitleChange": {
      "title": {
        "type": "string",
        "required": true,
        "constraints": {
          "minLength": 1,
          "maxLength": 255
        }
      }
    }
  },
  "operations": {
    "createBook": {
      "method": "POST",
      "path": "/api/books",
      "request": "BookRequest",
      "response": "Book",
      "capability": "catalog.write",
      "effects": [
        "write"
      ],
      "depends_on": [],
      "params": {}
    },
    "getBook": {
      "method": "GET",
      "path": "/api/books/{isbn}",
      "response": "Book",
      "capability": "catalog.read",
      "effects": [
        "read"
      ],
      "depends_on": [],
      "params": {
        "isbn": "string"
      }
    },
    "health": {
      "method": "GET",
      "path": "/health",
      "response": "Health",
      "capability": "public",
      "effects": [
        "read"
      ],
      "depends_on": [],
      "params": {}
    },
    "adjustStock": {
      "method": "PATCH",
      "path": "/api/books/{isbn}/stock",
      "params": {
        "isbn": "string"
      },
      "request": "StockAdjustment",
      "response": "Book",
      "capability": "catalog.write",
      "effects": [
        "read",
        "write"
      ],
      "depends_on": []
    },
    "listBooks": {
      "method": "GET",
      "path": "/api/books",
      "response": "BookPage",
      "capability": "catalog.read",
      "effects": [
        "read"
      ],
      "depends_on": [],
      "params": {},
      "query": {
        "limit": {
          "type": "integer",
          "required": false,
          "default": 25,
          "constraints": {
            "minimum": 1,
            "maximum": 50
          }
        },
        "offset": {
          "type": "integer",
          "required": false,
          "default": 0,
          "constraints": {
            "minimum": 0,
            "maximum": 1000000
          }
        }
      }
    },
    "renameBook": {
      "method": "PATCH",
      "path": "/api/books/{isbn}/title",
      "params": {
        "isbn": "string"
      },
      "request": "TitleChange",
      "response": "Book",
      "capability": "catalog.write",
      "effects": [
        "read",
        "write"
      ],
      "depends_on": []
    }
  }
}
