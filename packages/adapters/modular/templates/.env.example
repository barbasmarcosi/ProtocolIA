# Local development only. Copy to .env and supply distinct, nonempty secrets.
PROTOCOLIA_DB_PASSWORD=
PROTOCOLIA_AUTH_MODE=demo
# JWT verified resource-server mode (mutually exclusive with demo Basic).
PROTOCOLIA_JWT_ISSUER=
PROTOCOLIA_JWT_AUDIENCE=
PROTOCOLIA_JWT_JWKS_URI=
PROTOCOLIA_JWT_ALLOW_TEST_HTTP=false
# Optional SPA OAuth2 Authorization Code + PKCE; register this exact redirect URI with the provider.
PROTOCOLIA_OIDC_AUTHORIZATION_ENDPOINT=
PROTOCOLIA_OIDC_TOKEN_ENDPOINT=
PROTOCOLIA_OIDC_CLIENT_ID=
PROTOCOLIA_OIDC_REDIRECT_URI=
PROTOCOLIA_OIDC_SCOPE=openid profile
# Strict OIDC metadata verification at startup (issuer, endpoints and JWKS); requires RFC 9207 response iss.
PROTOCOLIA_OIDC_DISCOVERY_REQUIRED=false
# Requires strict discovery. Validates signed ID Token+nonce against the API session on login.
PROTOCOLIA_OIDC_ID_TOKEN_REQUIRED=false
# Spring BFF uses framework OIDC Client, with encrypted PostgreSQL sessions, HttpOnly and CSRF.
PROTOCOLIA_BFF_ENABLED=false
PROTOCOLIA_BFF_ENCRYPTION_KEY=
PROTOCOLIA_OIDC_BFF_REDIRECT_URI=
PROTOCOLIA_ALLOW_DEMO_AUTH=false
PROTOCOLIA_READER_USERNAME=reader
PROTOCOLIA_READER_PASSWORD=
PROTOCOLIA_MANAGER_USERNAME=manager
PROTOCOLIA_MANAGER_PASSWORD=
# Optional test-only third subject (all three required together).
PROTOCOLIA_SCOPED_USERNAME=
PROTOCOLIA_SCOPED_PASSWORD=
PROTOCOLIA_SCOPED_CAPABILITIES=
