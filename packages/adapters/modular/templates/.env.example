# Local development only. Copy to .env and supply distinct, nonempty secrets.
PROTOCOLIA_DB_PASSWORD=
PROTOCOLIA_AUTH_MODE=demo
# JWT verified resource-server mode (mutually exclusive with demo Basic).
PROTOCOLIA_JWT_ISSUER=
PROTOCOLIA_JWT_AUDIENCE=
PROTOCOLIA_JWT_JWKS_URI=
PROTOCOLIA_JWT_ALLOW_TEST_HTTP=false
PROTOCOLIA_ALLOW_DEMO_AUTH=false
PROTOCOLIA_READER_USERNAME=reader
PROTOCOLIA_READER_PASSWORD=
PROTOCOLIA_MANAGER_USERNAME=manager
PROTOCOLIA_MANAGER_PASSWORD=
# Optional test-only third subject (all three required together).
PROTOCOLIA_SCOPED_USERNAME=
PROTOCOLIA_SCOPED_PASSWORD=
PROTOCOLIA_SCOPED_CAPABILITIES=
