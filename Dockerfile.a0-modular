FROM eclipse-temurin:21-jdk AS java21
FROM node:24-bookworm AS node24
FROM maven:3.9.11-eclipse-temurin-21 AS maven39
FROM postgres:16-bookworm
COPY --from=java21 /opt/java/openjdk /opt/java/openjdk
COPY --from=node24 /usr/local /usr/local
COPY --from=maven39 /usr/share/maven /usr/share/maven
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=/opt/java/openjdk/bin:/usr/local/bin:/usr/share/maven/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git unzip && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY . .
RUN node --version && java -version && mvn -version && postgres --version
RUN npm ci --ignore-scripts
RUN npm run check:vnext && npm run compile:taller && bash tests/vnext/negative-check.sh
RUN node packages/adapters/modular/generate.mjs \
  examples/vnext/taller/tsp-output/@protocolia/compiler/ir.json \
  examples/vnext/taller/tsp-output/@typespec/openapi3/openapi.json \
  /work/dist/modular
RUN cd /work/dist/modular/web && npm install --ignore-scripts && npm run build
RUN npm install --no-save --package-lock=false --ignore-scripts playwright@1.64.0
RUN npx playwright install --with-deps chromium
RUN bash scripts/vnext/probe-openapi-generator.sh
RUN cd /work/dist/modular && mvn -B -ntp -DskipTests package
RUN bash scripts/vnext/probe-modular-postgres.sh
# Second source contract: no Java/SQL/React entity files are handwritten.
RUN node packages/adapters/modular/generate.mjs \
  examples/vnext/gauge/tsp-output/@protocolia/compiler/ir.json \
  examples/vnext/gauge/tsp-output/@typespec/openapi3/openapi.json \
  /work/dist/gauge
RUN cd /work/dist/gauge/web && npm install --ignore-scripts && npm run build
RUN PROTOCOLIA_TEST_CONTRACT=gauge PROTOCOLIA_APP_ROOT=/work/dist/gauge bash scripts/vnext/probe-openapi-generator.sh
RUN cd /work/dist/gauge && mvn -B -ntp -DskipTests package
RUN bash scripts/vnext/probe-gauge-postgres.sh
EXPOSE 3000
CMD ["node","-e","require('http').createServer((_,r)=>{r.writeHead(200);r.end('A0 modular isolated build marker only')}).listen(process.env.PORT||3000,'0.0.0.0')"]
