{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/barbasmarcosi/ProtocolIA/blob/main/schemas/broker-plan-v0.5.schema.json",
  "title": "ProtocolIA v0.5 read-only typed external-action DAG",
  "type": "object",
  "required": [
    "version",
    "plan_id",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.5"
    },
    "plan_id": {
      "$ref": "#/$defs/id"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "resource": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(?:/[a-z][a-z0-9_-]*){0,7}$"
    },
    "argument": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "object",
          "required": [
            "from"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "args",
        "depends_on",
        "capability",
        "effects",
        "timeout_ms",
        "output_type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "tool": {
          "enum": [
            "literal",
            "sha256",
            "assert.eq",
            "file.sha256"
          ]
        },
        "args": {
          "type": "object"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "capability": {
          "enum": [
            "compute.literal",
            "compute.sha256",
            "compute.assert",
            "file.sha256"
          ]
        },
        "effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "const": "read"
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000
        },
        "output_type": {
          "enum": [
            "string",
            "boolean"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tool": {
                "const": "literal"
              }
            },
            "required": [
              "tool"
            ]
          },
          "then": {
            "properties": {
              "capability": {
                "const": "compute.literal"
              },
              "effects": {
                "const": []
              },
              "output_type": {
                "const": "string"
              },
              "args": {
                "type": "object",
                "required": [
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "$ref": "#/$defs/argument"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "sha256"
              }
            },
            "required": [
              "tool"
            ]
          },
          "then": {
            "properties": {
              "capability": {
                "const": "compute.sha256"
              },
              "effects": {
                "const": []
              },
              "output_type": {
                "const": "string"
              },
              "args": {
                "type": "object",
                "required": [
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "$ref": "#/$defs/argument"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "assert.eq"
              }
            },
            "required": [
              "tool"
            ]
          },
          "then": {
            "properties": {
              "capability": {
                "const": "compute.assert"
              },
              "effects": {
                "const": []
              },
              "output_type": {
                "const": "boolean"
              },
              "args": {
                "type": "object",
                "required": [
                  "left",
                  "right"
                ],
                "additionalProperties": false,
                "properties": {
                  "left": {
                    "$ref": "#/$defs/argument"
                  },
                  "right": {
                    "$ref": "#/$defs/argument"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "file.sha256"
              }
            },
            "required": [
              "tool"
            ]
          },
          "then": {
            "properties": {
              "capability": {
                "const": "file.sha256"
              },
              "effects": {
                "const": [
                  "read"
                ]
              },
              "output_type": {
                "const": "string"
              },
              "args": {
                "type": "object",
                "required": [
                  "resource"
                ],
                "additionalProperties": false,
                "properties": {
                  "resource": {
                    "$ref": "#/$defs/resource"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
