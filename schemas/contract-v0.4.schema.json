{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "namespace",
    "models",
    "operations"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "0.4"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])"
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 200,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])"
        },
        "additionalProperties": {
          "$ref": "#/$defs/field"
        }
      }
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 200,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])"
      },
      "additionalProperties": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "type",
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\[\\])?$(?![\\s\\S])"
        },
        "required": {
          "type": "boolean"
        },
        "constraints": {
          "$ref": "#/$defs/constraints"
        },
        "nullable": {
          "type": "boolean"
        }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "method",
        "path",
        "response",
        "capability",
        "effects",
        "depends_on",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/(?:[A-Za-z0-9_-]+|\\{[A-Za-z][A-Za-z0-9_]*\\})(?:/(?:[A-Za-z0-9_-]+|\\{[A-Za-z][A-Za-z0-9_]*\\}))*$(?![\\s\\S])"
        },
        "response": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])"
        },
        "request": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])"
        },
        "capability": {
          "type": "string",
          "pattern": "^(?:public|[a-z][a-z0-9_.-]{0,79})$(?![\\s\\S])"
        },
        "effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])"
          },
          "additionalProperties": {
            "enum": [
              "string",
              "integer",
              "uuid"
            ]
          }
        },
        "query": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])"
          },
          "additionalProperties": {
            "$ref": "#/$defs/queryParameter"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "POST",
                  "PUT",
                  "PATCH"
                ]
              }
            }
          },
          "then": {
            "required": [
              "request"
            ]
          }
        },
        {
          "if": {
            "required": [
              "query"
            ]
          },
          "then": {
            "properties": {
              "method": {
                "const": "GET"
              }
            }
          }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "pattern": {
          "type": "string",
          "maxLength": 120
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "queryParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "required",
        "default",
        "constraints"
      ],
      "properties": {
        "type": {
          "const": "integer"
        },
        "required": {
          "const": false
        },
        "default": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "maximum": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        }
      }
    }
  },
  "$id": "https://github.com/barbasmarcosi/ProtocolIA/blob/main/schemas/contract-v0.2.schema.json",
  "title": "ProtocolIA v0.2 structural contract schema"
}
